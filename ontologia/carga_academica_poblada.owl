<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.ibero.mx/ontologias/carga-academica"
         xmlns="http://www.ibero.mx/ontologias/carga-academica#">

<owl:Ontology rdf:about="http://www.ibero.mx/ontologias/carga-academica">
  <rdfs:label xml:lang="es">Ontologia de recomendacion personalizada de carga academica</rdfs:label>
  <rdfs:comment xml:lang="es">Ontologia del proyecto Agente inteligente para la recomendacion personalizada de carga academica (Universidad Iberoamericana Puebla). Contiene unicamente clases, subclases, propiedades de objeto y propiedades de datos.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#cursaPrograma">
  <owl:inverseOf rdf:resource="#tieneEstudiante"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="#ProgramaAcademico"/>
  <rdfs:label xml:lang="es">cursaPrograma</rdfs:label>
  <rdfs:comment xml:lang="es">Un estudiante pertenece a un solo programa.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneEstudiante">
  <rdfs:domain rdf:resource="#ProgramaAcademico"/>
  <rdfs:range rdf:resource="#Estudiante"/>
  <rdfs:label xml:lang="es">tieneEstudiante</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de cursaPrograma.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#incluyeMateria">
  <owl:inverseOf rdf:resource="#perteneceAPrograma"/>
  <rdfs:domain rdf:resource="#ProgramaAcademico"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">incluyeMateria</rdfs:label>
  <rdfs:comment xml:lang="es">El programa define el conjunto de materias que lo componen. Su inversa se propone funcional (una materia, un programa).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#perteneceAPrograma">
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#ProgramaAcademico"/>
  <rdfs:label xml:lang="es">perteneceAPrograma</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de incluyeMateria.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tienePrerrequisito">
  <owl:inverseOf rdf:resource="#esPrerrequisitoDe"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">tienePrerrequisito</rdfs:label>
  <rdfs:comment xml:lang="es">Seriacion: una materia exige haber cursado otra. Se propone transitiva para heredar prerrequisitos indirectos.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esPrerrequisitoDe">
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">esPrerrequisitoDe</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de tienePrerrequisito.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneRegistro">
  <owl:inverseOf rdf:resource="#registroDe"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="#RegistroMateria"/>
  <rdfs:label xml:lang="es">tieneRegistro</rdfs:label>
  <rdfs:comment xml:lang="es">Un estudiante acumula registros en su historial.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#registroDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RegistroMateria"/>
  <rdfs:range rdf:resource="#Estudiante"/>
  <rdfs:label xml:lang="es">registroDe</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de tieneRegistro.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#registraMateria">
  <owl:inverseOf rdf:resource="#esRegistradaEn"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RegistroMateria"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">registraMateria</rdfs:label>
  <rdfs:comment xml:lang="es">Cada registro corresponde a exactamente una materia.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esRegistradaEn">
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#RegistroMateria"/>
  <rdfs:label xml:lang="es">esRegistradaEn</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de registraMateria.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#cursadoEnPeriodo">
  <owl:inverseOf rdf:resource="#incluyeRegistro"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RegistroMateria"/>
  <rdfs:range rdf:resource="#Periodo"/>
  <rdfs:label xml:lang="es">cursadoEnPeriodo</rdfs:label>
  <rdfs:comment xml:lang="es">Indica cuando se curso la materia.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#incluyeRegistro">
  <rdfs:domain rdf:resource="#Periodo"/>
  <rdfs:range rdf:resource="#RegistroMateria"/>
  <rdfs:label xml:lang="es">incluyeRegistro</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de cursadoEnPeriodo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#haAprobado">
  <owl:inverseOf rdf:resource="#aprobadaPor"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">haAprobado</rdfs:label>
  <rdfs:comment xml:lang="es">Atajo derivado de RegistroAprobado: facilita la regla de prerrequisitos.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aprobadaPor">
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#Estudiante"/>
  <rdfs:label xml:lang="es">aprobadaPor</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de haAprobado.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#puedeCursar">
  <owl:inverseOf rdf:resource="#puedeSerCursadaPor"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">puedeCursar</rdfs:label>
  <rdfs:comment xml:lang="es">Resultado del razonamiento: materias que el alumno cumple requisitos para cursar.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#puedeSerCursadaPor">
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#Estudiante"/>
  <rdfs:label xml:lang="es">puedeSerCursadaPor</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de puedeCursar.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esOfertaDe">
  <owl:inverseOf rdf:resource="#tieneGrupo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">esOfertaDe</rdfs:label>
  <rdfs:comment xml:lang="es">Un grupo es oferta de una sola materia.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneGrupo">
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">tieneGrupo</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de esOfertaDe.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#impartidoPor">
  <owl:inverseOf rdf:resource="#imparteGrupo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#Profesor"/>
  <rdfs:label xml:lang="es">impartidoPor</rdfs:label>
  <rdfs:comment xml:lang="es">Cada grupo tiene un profesor titular.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#imparteGrupo">
  <rdfs:domain rdf:resource="#Profesor"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">imparteGrupo</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de impartidoPor.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneBloqueHorario">
  <owl:inverseOf rdf:resource="#bloqueDeGrupo"/>
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#BloqueHorario"/>
  <rdfs:label xml:lang="es">tieneBloqueHorario</rdfs:label>
  <rdfs:comment xml:lang="es">Un grupo puede reunirse varios dias (varios bloques).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#bloqueDeGrupo">
  <rdfs:domain rdf:resource="#BloqueHorario"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">bloqueDeGrupo</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de tieneBloqueHorario.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneModalidad">
  <owl:inverseOf rdf:resource="#modalidadDeGrupo"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#Modalidad"/>
  <rdfs:label xml:lang="es">tieneModalidad</rdfs:label>
  <rdfs:comment xml:lang="es">Un grupo se imparte en una modalidad.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#modalidadDeGrupo">
  <rdfs:domain rdf:resource="#Modalidad"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">modalidadDeGrupo</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de tieneModalidad.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ofrecidoEnPeriodo">
  <owl:inverseOf rdf:resource="#periodoOfrece"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#Periodo"/>
  <rdfs:label xml:lang="es">ofrecidoEnPeriodo</rdfs:label>
  <rdfs:comment xml:lang="es">El grupo existe en un periodo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#periodoOfrece">
  <rdfs:domain rdf:resource="#Periodo"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">periodoOfrece</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de ofrecidoEnPeriodo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#enConflictoCon">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">enConflictoCon</rdfs:label>
  <rdfs:comment xml:lang="es">Dos grupos que se traslapan en horario.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tienePreferencia">
  <owl:inverseOf rdf:resource="#esPreferenciaDe"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="#Preferencia"/>
  <rdfs:label xml:lang="es">tienePreferencia</rdfs:label>
  <rdfs:comment xml:lang="es">Cada preferencia pertenece a un solo estudiante.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esPreferenciaDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Preferencia"/>
  <rdfs:range rdf:resource="#Estudiante"/>
  <rdfs:label xml:lang="es">esPreferenciaDe</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de tienePreferencia.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefiereModalidad">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PreferenciaModalidad"/>
  <rdfs:range rdf:resource="#Modalidad"/>
  <rdfs:label xml:lang="es">prefiereModalidad</rdfs:label>
  <rdfs:comment xml:lang="es">Liga una preferencia con la modalidad deseada.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#propuestaPara">
  <owl:inverseOf rdf:resource="#recibePropuesta"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PropuestaCarga"/>
  <rdfs:range rdf:resource="#Estudiante"/>
  <rdfs:label xml:lang="es">propuestaPara</rdfs:label>
  <rdfs:comment xml:lang="es">Cada propuesta se genera para un estudiante.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recibePropuesta">
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="#PropuestaCarga"/>
  <rdfs:label xml:lang="es">recibePropuesta</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de propuestaPara.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#propuestaParaPeriodo">
  <owl:inverseOf rdf:resource="#periodoTienePropuesta"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PropuestaCarga"/>
  <rdfs:range rdf:resource="#Periodo"/>
  <rdfs:label xml:lang="es">propuestaParaPeriodo</rdfs:label>
  <rdfs:comment xml:lang="es">La propuesta aplica a un periodo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#periodoTienePropuesta">
  <rdfs:domain rdf:resource="#Periodo"/>
  <rdfs:range rdf:resource="#PropuestaCarga"/>
  <rdfs:label xml:lang="es">periodoTienePropuesta</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de propuestaParaPeriodo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#incluyeGrupo">
  <owl:inverseOf rdf:resource="#incluidoEnPropuesta"/>
  <rdfs:domain rdf:resource="#PropuestaCarga"/>
  <rdfs:range rdf:resource="#Grupo"/>
  <rdfs:label xml:lang="es">incluyeGrupo</rdfs:label>
  <rdfs:comment xml:lang="es">Una propuesta se compone de varios grupos.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#incluidoEnPropuesta">
  <rdfs:domain rdf:resource="#Grupo"/>
  <rdfs:range rdf:resource="#PropuestaCarga"/>
  <rdfs:label xml:lang="es">incluidoEnPropuesta</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de incluyeGrupo.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#generadaPor">
  <owl:inverseOf rdf:resource="#generaPropuesta"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PropuestaCarga"/>
  <rdfs:range rdf:resource="#Agente"/>
  <rdfs:label xml:lang="es">generadaPor</rdfs:label>
  <rdfs:comment xml:lang="es">En Contract Net cada propuesta la emite un agente.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#generaPropuesta">
  <rdfs:domain rdf:resource="#Agente"/>
  <rdfs:range rdf:resource="#PropuestaCarga"/>
  <rdfs:label xml:lang="es">generaPropuesta</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de generadaPor.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aplicaAPrograma">
