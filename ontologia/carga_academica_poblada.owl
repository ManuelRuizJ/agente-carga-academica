<owl:Class rdf:about="#GrupoVespertino">
  <rdfs:subClassOf rdf:resource="#Grupo"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Grupo"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneBloqueHorario"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#BloqueHorario"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#turno"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vespertino</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grupo con al menos un bloque vespertino</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GrupoMatutino">
  <rdfs:subClassOf rdf:resource="#Grupo"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Grupo"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneBloqueHorario"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#BloqueHorario"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#turno"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matutino</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grupo con al menos un bloque matutino</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GrupoEnLinea">
  <rdfs:subClassOf rdf:resource="#Grupo"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Grupo"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneModalidad"/>
          <owl:someValuesFrom rdf:resource="#ModalidadEnLinea"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grupo ofrecido en línea</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MateriaSeriada">
  <rdfs:subClassOf rdf:resource="#Materia"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Materia"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tienePrerrequisito"/>
          <owl:someValuesFrom rdf:resource="#Materia"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Materia que tiene al menos un prerrequisito</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MateriaLlave">
  <rdfs:subClassOf rdf:resource="#Materia"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Materia"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#esPrerrequisitoDe"/>
          <owl:onClass rdf:resource="#Materia"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Materia que es prerrequisito de 2 o más materias</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EstudianteConAdeudo">
  <rdfs:subClassOf rdf:resource="#Estudiante"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Estudiante"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tieneRegistro"/>
          <owl:someValuesFrom rdf:resource="#RegistroReprobado"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Estudiante con al menos una materia reprobada</rdfs:comment>
</owl:Class>

