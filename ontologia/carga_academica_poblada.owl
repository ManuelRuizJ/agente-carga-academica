<owl:Class rdf:about="#Persona">
  <rdfs:label xml:lang="es">Persona</rdfs:label>
  <rdfs:comment xml:lang="es">Individuo que interactua con la universidad. Raiz comun para estudiantes y profesores; evita repetir atributos como el nombre.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Estudiante">
  <rdfs:subClassOf rdf:resource="#Persona"/>
  <rdfs:label xml:lang="es">Estudiante</rdfs:label>
  <rdfs:comment xml:lang="es">Alumno de la Ibero Puebla para quien se genera la recomendacion. Concentra historial, preferencias y propuestas.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Profesor">
  <rdfs:subClassOf rdf:resource="#Persona"/>
  <rdfs:label xml:lang="es">Profesor</rdfs:label>
  <rdfs:comment xml:lang="es">Docente que imparte grupos. Permite relacionar la oferta con quien la imparte.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ProgramaAcademico">
  <rdfs:label xml:lang="es">ProgramaAcademico</rdfs:label>
  <rdfs:comment xml:lang="es">Licenciatura o plan de estudios; define que materias aplican al alumno y los creditos totales.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Materia">
  <rdfs:label xml:lang="es">Materia</rdfs:label>
  <rdfs:comment xml:lang="es">Asignatura del catalogo con clave, creditos y relaciones de seriacion.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MateriaObligatoria">
  <rdfs:subClassOf rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">MateriaObligatoria</rdfs:label>
  <rdfs:comment xml:lang="es">Materia que el plan exige cursar.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MateriaOptativa">
  <rdfs:subClassOf rdf:resource="#Materia"/>
  <rdfs:label xml:lang="es">MateriaOptativa</rdfs:label>
  <rdfs:comment xml:lang="es">Materia de libre eleccion.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Periodo">
  <rdfs:label xml:lang="es">Periodo</rdfs:label>
  <rdfs:comment xml:lang="es">Semestre o ciclo escolar (por ejemplo, Otono 2026) en el que se ofertan grupos y se cursan materias.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Grupo">
  <rdfs:label xml:lang="es">Grupo</rdfs:label>
  <rdfs:comment xml:lang="es">Oferta concreta de una materia: materia + profesor + horario + modalidad + periodo. Es lo que el alumno realmente inscribe.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BloqueHorario">
  <rdfs:label xml:lang="es">BloqueHorario</rdfs:label>
  <rdfs:comment xml:lang="es">Franja de dia y hora en que se imparte un grupo.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Modalidad">
  <rdfs:label xml:lang="es">Modalidad</rdfs:label>
  <rdfs:comment xml:lang="es">Forma de impartir un grupo.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ModalidadPresencial">
  <rdfs:subClassOf rdf:resource="#Modalidad"/>
  <rdfs:label xml:lang="es">ModalidadPresencial</rdfs:label>
  <rdfs:comment xml:lang="es">Clases en el campus.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ModalidadEnLinea">
  <rdfs:subClassOf rdf:resource="#Modalidad"/>
  <rdfs:label xml:lang="es">ModalidadEnLinea</rdfs:label>
  <rdfs:comment xml:lang="es">Clases totalmente remotas.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ModalidadHibrida">
  <rdfs:subClassOf rdf:resource="#Modalidad"/>
  <rdfs:label xml:lang="es">ModalidadHibrida</rdfs:label>
  <rdfs:comment xml:lang="es">Combinacion de presencial y remoto.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RegistroMateria">
  <rdfs:label xml:lang="es">RegistroMateria</rdfs:label>
  <rdfs:comment xml:lang="es">Renglon del historial academico (kardex): una materia cursada por un estudiante en un periodo.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RegistroAprobado">
  <rdfs:subClassOf rdf:resource="#RegistroMateria"/>
  <rdfs:label xml:lang="es">RegistroAprobado</rdfs:label>
  <rdfs:comment xml:lang="es">Materia cursada y aprobada.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RegistroReprobado">
  <rdfs:subClassOf rdf:resource="#RegistroMateria"/>
  <rdfs:label xml:lang="es">RegistroReprobado</rdfs:label>
