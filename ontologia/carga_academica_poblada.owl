  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RestriccionAcademica"/>
  <rdfs:range rdf:resource="#ProgramaAcademico"/>
  <rdfs:label xml:lang="es">aplicaAPrograma</rdfs:label>
  <rdfs:comment xml:lang="es">Las reglas pueden diferir por programa.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneRestriccion">
  <rdfs:domain rdf:resource="#ProgramaAcademico"/>
  <rdfs:range rdf:resource="#RestriccionAcademica"/>
  <rdfs:label xml:lang="es">tieneRestriccion</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de aplicaAPrograma.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#trazaDeAgente">
  <owl:inverseOf rdf:resource="#registraTraza"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#TrazaEjecucion"/>
  <rdfs:range rdf:resource="#Agente"/>
  <rdfs:label xml:lang="es">trazaDeAgente</rdfs:label>
  <rdfs:comment xml:lang="es">Cada traza pertenece a un agente.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#registraTraza">
  <rdfs:domain rdf:resource="#Agente"/>
  <rdfs:range rdf:resource="#TrazaEjecucion"/>
  <rdfs:label xml:lang="es">registraTraza</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de trazaDeAgente.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#trazaDePropuesta">
  <owl:inverseOf rdf:resource="#tieneTraza"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#TrazaEjecucion"/>
  <rdfs:range rdf:resource="#PropuestaCarga"/>
  <rdfs:label xml:lang="es">trazaDePropuesta</rdfs:label>
  <rdfs:comment xml:lang="es">Liga trazas con la propuesta que originaron.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#tieneTraza">
  <rdfs:domain rdf:resource="#PropuestaCarga"/>
  <rdfs:range rdf:resource="#TrazaEjecucion"/>
  <rdfs:label xml:lang="es">tieneTraza</rdfs:label>
  <rdfs:comment xml:lang="es">Inversa de trazaDePropuesta.</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nombre">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
