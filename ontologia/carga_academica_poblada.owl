  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="es">nombre</rdfs:label>
  <rdfs:comment xml:lang="es">Nombre completo de la persona.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#matricula">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="es">matricula</rdfs:label>
  <rdfs:comment xml:lang="es">Identificador unico del alumno.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#semestreActual">
