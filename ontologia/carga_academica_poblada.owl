  <rdfs:label xml:lang="es">semestreActual</rdfs:label>
  <rdfs:comment xml:lang="es">Semestre en el que se encuentra.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#promedioGeneral">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Estudiante"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="es">promedioGeneral</rdfs:label>
