  <rdfs:label xml:lang="es">claveEmpleado</rdfs:label>
  <rdfs:comment xml:lang="es">Identificador del profesor.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#claveMateria">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="es">claveMateria</rdfs:label>
  <rdfs:comment xml:lang="es">Clave oficial de la materia.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nombreMateria">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="es">nombreMateria</rdfs:label>
  <rdfs:comment xml:lang="es">Nombre de la materia.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#creditos">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Materia"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="es">creditos</rdfs:label>
  <rdfs:comment xml:lang="es">Creditos que vale la materia.</rdfs:comment>
